# Abra Travels backend — configuration template
# Copy to backend/.env.development and fill in values locally. Never commit real .env files.
# Full reference: documentation/environment-variables.md

NODE_ENV=development
PORT=4000
PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
LOG_LEVEL=debug
# Swagger UI at /api/docs. Default: on outside production. Validation refuses true in production.
API_DOCS_ENABLED=true
# Reverse proxies / load balancers in front of the API (0 locally). Needed for the real client IP
# used by rate limits and the session list; set to the number of trusted hops in production.
TRUST_PROXY_HOPS=0

# Backend running on Windows:   mongodb://localhost:27017/abra_travels?directConnection=true
# Backend running in Docker:    set automatically by docker-compose (mongodb service)
MONGODB_URI=mongodb://localhost:27017/abra_travels?directConnection=true
REDIS_URL=redis://localhost:6379
# Namespace of rate-limit and sign-in lockout keys (BullMQ uses QUEUE_PREFIX)
REDIS_KEY_PREFIX=abra

# Generate locally, e.g.:  node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Shorter refresh-token lifetime for STAFF, OPERATOR_STAFF and PARTNER_USER accounts
REFRESH_TOKEN_TTL_DAYS_STAFF=7
# Domain attribute of the web refresh-token cookie; leave empty for a host-only cookie
AUTH_COOKIE_DOMAIN=
# Staging/production sign access tokens with an asymmetric key pair (PEM) instead of JWT_ACCESS_SECRET
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ISSUER=abra-travels
JWT_AUDIENCE=abra-travels-apps

# OTP (documentation/authentication.md §3): 6 digits, stored hashed, 5-min expiry,
# 5 verify attempts, 3 sends per 15 min per number and per IP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_SECONDS=900
# Minimum time between two codes to the same number
OTP_RESEND_COOLDOWN_SECONDS=30
# Codes per IP per OTP_SEND_WINDOW_SECONDS (higher than per number: carriers share IPs)
OTP_MAX_SENDS_PER_IP_PER_WINDOW=20
# Pepper for OTP hashes, 32 random bytes base64 (generate locally)
OTP_HASH_SECRET=

# Password login lockout (authentication.md §4): 5 failures -> 15-minute lock
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Sign-in attempts (any identifier) per IP within LOGIN_LOCKOUT_SECONDS
LOGIN_MAX_ATTEMPTS_PER_IP_PER_WINDOW=50
MFA_TOTP_ISSUER=Abra Travels
# STAFF accounts must set up TOTP before their session can do anything else.
# Validation refuses false in production.
MFA_REQUIRED_FOR_STAFF=false
# Lifetime of the token linking a correct password to the second-factor step
MFA_CHALLENGE_TTL_SECONDS=300

# BullMQ (uses REDIS_URL). Retries: exponential back-off, 5 attempts (notification-architecture.md)
QUEUE_PREFIX=abra
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=5000
WORKER_CONCURRENCY=5
# Readiness reports a queue as lagging when its oldest waiting job is older than this
QUEUE_LAG_ALERT_MS=60000

# Transactional outbox relay (runs in the worker process)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_PUBLISH_ATTEMPTS=20
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# development = clearly labelled local adapters; real providers are configured in staging/production
PAYMENT_GATEWAY=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_PROVIDER=development
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

SMS_PROVIDER=development
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

EMAIL_PROVIDER=development
EMAIL_API_KEY=
EMAIL_FROM=no-reply@abratravels.local

PUSH_PROVIDER=development
FCM_SERVICE_ACCOUNT_JSON=

MAPS_PROVIDER=development
MAPS_API_KEY=

AI_PROVIDER=development
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
